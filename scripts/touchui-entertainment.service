[Unit]
Description=Kali Touch browser, dashboard and device controls
After=graphical.target

[Service]
Type=simple
User=kali
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/opt/kali-touch-ui
ExecStart=/usr/bin/python3 /opt/kali-touch-ui/backend/entertainment.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
